# =========================================================================
# TEAMSYNC ENVIRONMENT VARIABLES
# =========================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=teamsync
DATABASE_URL="postgresql://postgres:password123@localhost:5432/teamsync?schema=public"

# Redis Cache & Ephemeral Presence
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="super_secret_teamsync_production_key_2026"
JWT_EXPIRES_IN="7d"

# Server Ports & CORS
PORT=5000
CLIENT_URL="http://localhost:3000"
